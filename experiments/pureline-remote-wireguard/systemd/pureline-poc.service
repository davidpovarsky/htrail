[Unit]
Description=Pureline research WireGuard MITM image filter (single tester)
Wants=network-online.target
Requires=pureline-firewall.service
After=network-online.target pureline-firewall.service

[Service]
Type=simple
User=chatgpt-agent
Group=chatgpt-agent
WorkingDirectory=/srv/pureline-poc
ExecStart=/srv/pureline-poc/.venv/bin/mitmdump --mode wireguard@51820 --listen-host 0.0.0.0 --set confdir=/srv/pureline-poc/wg-profile --set local_image_filter_config=/srv/pureline-poc/config/pureline.toml --set flow_detail=0 --set connection_strategy=lazy -q -s /srv/pureline-poc/pureline_addon.py
ExecStartPre=/srv/pureline-poc/.venv/bin/python -m py_compile /srv/pureline-poc/pureline_addon.py
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/pureline-poc
MemoryMax=2G
CPUQuota=120%
TasksMax=128
LimitNOFILE=4096
OOMScoreAdjust=500
StandardOutput=null
StandardError=journal
SyslogIdentifier=pureline-poc

[Install]
WantedBy=multi-user.target
